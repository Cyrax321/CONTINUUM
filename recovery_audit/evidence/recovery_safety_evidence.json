  "findings": [
    {
      "id": "F1",
      "severity": "high",
      "class": "duplicate external side effect",
      "component": "continuum.actions.ledger.ActionLedger.claim",
      "symptom": "two interleaved claims on one identity both received fresh=True and both performed the side effect",
      "root_cause": "claim folds the log to decide the slot is free, then appends; no expected_sequence was passed to append_event, so nothing made the read-then-write atomic",
      "fix": "capture last_sequence before resolve_claim, thread expected_sequence through the three slot-opening _record writes, and re-fold on ConcurrentWriteError",
      "status": "fixed in the reference worktree; regression test added"
    },
    {
      "id": "F2",
      "severity": "high",
      "class": "silent unsafe resumption",
      "component": "continuum.checkpoint.manager.CheckpointManager.restore / continuum.recovery.engine.RecoveryEngine.assess",
      "symptom": "a poisoned log raised CorruptedRecord out of assess instead of degrading",
      "root_cause": "storage refuses to parse a corrupted payload on read, before the fold's on_unprojectable='degrade' machinery can engage; five auxiliary readers in assess had no degrade path either",
      "fix": "read the readable prefix under degrade, mark the state INVALID at the sequence storage refused (so _decide escalates rather than advising resume over an unreadable log), and guard the auxiliary readers",
      "status": "fixed in the reference worktree; regression test added"
    }
  ],
